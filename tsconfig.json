{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitThis": true,
    "types": []
  },
  "include": ["js/**/*.js", "types.d.ts"],
  "exclude": ["node_modules", "tests", "e2e"]
}
