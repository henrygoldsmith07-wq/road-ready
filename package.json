{
  "name": "road-ready",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first jurisdiction-aware driving-theory study PWA (vanilla JS, no build step)",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node serve.js",
    "test": "npm run test:unit && npm run validate && npm run hygiene && npm run stats:check",
    "stats:check": "node scripts/product-stats.mjs --check",
    "stats:update": "node scripts/product-stats.mjs --write",
    "test:unit": "vitest run",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-content.mjs --strict",
    "provenance:update": "node scripts/validate-content.mjs --update-manifest",
    "content:coverage": "node scripts/content-coverage.mjs",
    "content:coverage:write": "node scripts/content-coverage.mjs --write",
    "content:coverage:check": "node scripts/content-coverage.mjs --check",
    "check:concepts": "node scripts/check-concepts.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "sw:version": "node scripts/update-sw.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "hygiene": "node scripts/check-hygiene.mjs",
    "verify": "npm run lint && npm run typecheck && npm run sw:version -- --check && npm test && npm run content:coverage:check && npm run check:concepts && npm run check:privacy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
